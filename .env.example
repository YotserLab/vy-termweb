# VY-TermWEB runs entirely on real connections — no API keys needed.
# Copy to .env only if you want to override defaults.

# PORT: HTTP port for the VY-TermWEB server (default 3000)
# PORT=3000

# SHELL: shell used for Local Shell sessions (default: $SHELL or /bin/bash)
# SHELL=/bin/bash

# VY_MASTER_PASSWORD: require a master password to open the web panel.
# Leave unset to use the first-run setup screen (hash stored in ~/.vy-termweb/auth.json),
# or keep both unset for an open panel (trusted networks only).
# VY_MASTER_PASSWORD=

# VY_AUTH_DISABLED=1: disable the panel gate entirely (dev, or when another
# layer already authenticates). Dev mode is also auto-detected when DIST_DIR
# is set (dev.sh) — `pnpm dev` never asks for a password.
# VY_AUTH_DISABLED=
